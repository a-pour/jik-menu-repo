rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "admin@dinemenu.com" || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "system_admin");
    }

    function isRestaurantOwner(restaurantId) {
      let restaurant = get(/databases/$(database)/documents/restaurants/$(restaurantId)).data;
      return isAuthenticated() && (restaurant.ownerEmail == request.auth.token.email);
    }

    // Restaurants
    match /restaurants/{restaurantId} {
      allow read: if true; // Publicly readable for menu view
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isRestaurantOwner(restaurantId);
      
      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId) || isAdmin();
      }
      
      // Foods subcollection
      match /foods/{foodId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId) || isAdmin();
      }
    }

    // Users (for roles)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && request.resource.data.role == resource.data.role);
    }
  }
}
